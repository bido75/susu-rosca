DATABASE_URL="postgresql://susuflow:susuflow@127.0.0.1:5432/susuflow?schema=public"
APP_URL="http://localhost:3000"
# Optional SMTP for real magic-link delivery. Without SMTP, links are printed in dev server logs ONLY when NODE_ENV=development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SusuFlow <no-reply@example.com>"
# Set to "false" to allow the session cookie over plain HTTP (e.g. local Docker).
# Leave unset for HTTPS production (defaults to `secure` when NODE_ENV=production).
COOKIE_SECURE=

# Sentry error monitoring & tracing.
# Public browser DSN (must be NEXT_PUBLIC_ to reach the client bundle):
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN (backend API route handlers / instrumentation):
SENTRY_DSN=
# Optional: Sentry org/project slugs for source-map upload; auth token is CI-only.
SENTRY_ORG=v-and-j-web-design-and-hosting
SENTRY_PROJECT=susuflow
# SENTRY_AUTH_TOKEN=  # secret — set in CI/Docker env only, never committed
