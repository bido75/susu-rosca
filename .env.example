DATABASE_URL="postgresql://susuflow:susuflow@127.0.0.1:5432/susuflow?schema=public"
# Public URL used to build sign-in links in emails. Use https://susu.giscop.com in production.
APP_URL="https://susu.giscop.com"
# Transactional email via Resend (preferred). Verify your domain at
# resend.com/domains so you can send from your own domain to any recipient.
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS="SusuFlow <no-reply@yourdomain.com>"
# SMTP fallback (used only when RESEND_API_KEY is unset):
# SMTP_HOST=mail.example.com
# SMTP_PORT=465   # 465 = implicit TLS; 587 = STARTTLS
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="SusuFlow <you@example.com>"
# Set to "false" to allow the session cookie over plain HTTP (e.g. local Docker).
# Leave unset for HTTPS production (defaults to `secure` when NODE_ENV=production).
COOKIE_SECURE=

# Sentry error monitoring & tracing.
# Public browser DSN (must be NEXT_PUBLIC_ to reach the client bundle):
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN (backend API route handlers / instrumentation):
SENTRY_DSN=
# Optional: Sentry org/project slugs for source-map upload; auth token is CI-only.
SENTRY_ORG=v-and-j-web-design-and-hosting
SENTRY_PROJECT=susuflow
# SENTRY_AUTH_TOKEN=  # secret — set in CI/Docker env only, never committed

# Release + environment tagging (set automatically in CI from the commit SHA).
# SENTRY_RELEASE=            # e.g. git SHA or semver
# SENTRY_ENVIRONMENT=        # staging | production
# NEXT_PUBLIC_SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Private storage for uploaded payment evidence (screenshots/receipts).
# Mount as a volume in Docker; never served as static files.
EVIDENCE_DIR=./data/evidence

# Rate limiting: default is in-process ("memory"). Set to "upstash"/"redis"
# and provide the connection env vars to scale limits across instances.
RATE_LIMIT_PROVIDER=memory

# Scheduled backups (see docker-compose.yml `backups` service).
# SCHEDULE and retention are set in compose; the volume `backups` holds the dumps.
# BACKUP_KEEP_DAYS=7
# BACKUP_KEEP_WEEKS=4
# BACKUP_KEEP_MONTHS=3

# Cloudflare Tunnel token for public HTTPS (susu.giscop.com). Secret — never commit.
CLOUDFLARE_TUNNEL_TOKEN=
